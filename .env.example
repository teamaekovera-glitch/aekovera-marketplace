# ============================================================================
# Aekovera Marketplace — Environment Variables
# (env matrix from docs/specs/02_ARCHITECTURE.md section 4)
#
# MOCK-FIRST: the app boots, builds, and passes tests with every value below
# empty. Configure a service by filling in its keys — no code changes needed.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL 16 + Auth + Storage). Empty = mock auth/db mode.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection used by `npm run db:migrate` and the RLS tests
# (not consumed by the Next.js app). On Supabase use the session pooler URI.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aekovera_dev
# Fresh database the RLS integration tests migrate into (CI sets this too).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aekovera_test

# ---------------------------------------------------------------------------
# Algolia (search). Empty = in-memory mock search adapter.
# ---------------------------------------------------------------------------
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# Index names (defaults shown; override per environment if needed)
ALGOLIA_BRANDS_INDEX=brands
ALGOLIA_PRODUCTS_INDEX=products

# ---------------------------------------------------------------------------
# Stripe (billing). Empty = mock billing adapter (no charges, plan simulation).
# Price IDs default to the spec values in 07_SECURITY_PAYMENTS_SPEC.md §4.1;
# override with the live price IDs created in the Stripe dashboard.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_YEARLY=price_starter_yearly
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly
STRIPE_PRICE_ENTERPRISE_YEARLY=price_enterprise_yearly

# ---------------------------------------------------------------------------
# Anthropic (AI matching/content — Phase 3/4). Reserved per env matrix.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Resend (transactional email). Empty = emails logged to the server console.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aekovera Marketplace <noreply@aekovera.example>

# ---------------------------------------------------------------------------
# Inngest (background jobs). Empty = jobs execute inline in-process.
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Observability — both optional; the app never requires these to boot.
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
